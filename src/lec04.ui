              <enum>QFrame::Sunken</enum>
             </property>
             <property name="text">
              <string>Mia nomo estas Petro. Mi vivas en Brazilo. Mi komencis lerni Esperanton antaŭ kvar semajnoj. Ĝi estas tre facila lingvo. Mi loĝas en domo kun mia edzino kaj niaj infanoj. Ni havas unu filon kaj du filinojn. Mi kolektas poŝtmarkojn kaj bildkartojn kaj ŝatas interŝanĝi ilin kun esperantistoj en aliaj landoj.</string>
             </property>
             <property name="wordWrap">
              <bool>true</bool>
             </property>
             <property name="margin">
              <number>5</number>
