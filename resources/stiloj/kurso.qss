klakbutono_nova {
    font-weight: bold;
    color: #2E4272;
}

klakbutono_nova:pressed {
    padding-left: 1px;
    padding-top: 4px;
}


QLabel[tipo="titolo_alia"] {
        font-size: 16px;
        font-weight: bold;
        }

QSpinBox[tipo="shilda"] {
        min-height: 24px;
        font-size: 18px;
        font-weight: bold;
        }


QFrame[tipo="senborda"] {
        border: none;
        }

neklakebla_nova,  QFrame[tipo="esperanta"]  {
    font-weight: bold;
    color: #D35828;
 }

korekta  {
    color: #D35828;
 }


label_sago_reversa, QLabel[tipo="egala"] {
        margin-left: 15px;
        max-height: 24px;
        min-height: 24px;
        max-width:  24px;
        min-width:  24px;
        }


QFrame[tipo="shilda"] {
        border: 1px solid lightGrey;
        border-radius: 3px;
}

QFrame[tipo="ekzerca"] {
   border-width: 1px;
   border-style: solid;
   border-radius: 3px;
}

QFrame[tipo="markebla"] {
   border-width: 2px;
   border-style: solid;
   border-radius: 5px;
}


mp3ludilo {
        max-height: 34px;
        max-width:  71px;
        min-height: 34px;
        min-width:  71px;
        }

