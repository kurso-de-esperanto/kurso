
QFrame[tipo="shilda"], QSpinBox[tipo="shilda"] {
	background-color: #FDEAE4;
}


QFrame[tipo="markebla"] {
   border-color: #DB9375;
}

QFrame[tipo="ekzerca"] {
   border-top-color: #e5b39e;
   border-left-color: #e5b39e;
   border-right-color: #f4ded5;
   border-bottom-color: #f4ded5;
   background-color: #fbf4f1;
}

QLabel[tipo="teksta"] {
         background: qlineargradient( x1:0, y1:0, x2:0, y2:1,
	 stop:0 #FDEAE4, 
	 stop:0.15 #fbf4f1, 
	 stop:0.85 #fbf4f1, 
	 stop:1   #FDEAE4); 
	 }

QPushButton[tipo="speciala"] {
        border: 1px solid black;
	border-radius: 5px;
	min-height: 2em;
        padding-left: 1em;
        padding-right: 1em;
	}


QPushButton[tipo="speciala"]:enabled {
         /* background: qlineargradient( x1:0, y1:0, x2:0, y2:1, stop:0 #FDF8F5, stop:1 #DB9375); */
         background-color: #FDEAE4;
         }
    
QPushButton[tipo="speciala"]:disabled {
   	 background-color: white;
	 color: #666666;
	 }

QPushButton[tipo="speciala"]:pressed {
	 padding-top: 5px;
	 padding-left: 5px;
	 }

/*
QPushButton[tipo="speciala"]:hover {
   	 background: qlineargradient( x1:0, y1:0, x2:0, y2:1, 
	 stop:0 #DB9375, 
	 stop:0.2 #FDF8F5, 
	 stop:0.8 #FDF8F5, 
	 stop:1   #DB9375); 
	 }

*/

klakbutono {
    text-align: left;
    font-weight: bold;
    color: #0000B9;
}

klakbutono:pressed {
    padding-left: 1px;
    padding-top: 4px;
}

/* importitaj el kurso_eta.qss */

QTabBar::scroller { /* the width of the scroll buttons */
    width: 50px;
}


QLabel {
        qproperty-wordWrap: true;
        }

QLabel[tipo="titolo_alia"] {
        font-size: 16px;
        font-weight: bold;
        }

QSpinBox[tipo="shilda"] {
        min-height: 32px;
        font-size: 24px;
        font-weight: bold;
        }


QLabel[tipo="neklakebla"] {
        color: #FF6333;

}


neklakebla[tipo="akuzativa"] {
         color: black;
}


QFrame[tipo="senborda"] {
        border: none;
        }


neklakebla {

     border: 0px;
     min-width: 20px;
     min-height: 1em;
     /* max-height: 1.5em; */
     margin-right: 5px;

    font-weight: bold;
    color: #FF6333;

 }



label_sago_reversa {
        margin-left: 15px;
        /* background-image: url(:ikonoj/sago_revena.png); */
        max-height: 24px;
        min-height: 24px;
        max-width:  24px;
        min-width:  24px;
        }


QFrame[tipo="shilda"] {
        border: 1px solid lightGrey;
        border-radius: 3px;
}

QFrame[tipo="ekzerca"] {
   border-width: 1px;
   border-style: solid;
   border-radius: 3px;
}

QFrame[tipo="markebla"] {
   border-width: 2px;
   border-style: solid;
   border-radius: 5px;
}


mp3ludilo {
        max-height: 34px;
        max-width:  71px;
        min-height: 34px;
        min-width:  71px;
        }



